# Copiá este archivo como .env. Vite mete estos valores adentro del build,
# así que acá van solo datos públicos: nunca un secreto.

# URL de la API. Obligatoria para compilar (npm run build): https en
# producción; http://localhost:3000 sirve para probar en tu máquina.
VITE_API_URL=http://localhost:3000

# Cloudinary: cuenta y upload preset para las imágenes. Si la API tiene
# CLOUDINARY_API_KEY/SECRET, las subidas van firmadas y el preset queda
# solo de respaldo.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

